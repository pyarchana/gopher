# Optional. Raises the GitHub API rate limit from 60 to 5000 requests/hour.
# Generate at https://github.com/settings/tokens (no scopes needed for public repos).
GITHUB_TOKEN=

# Where context.json, diary.md and digest_log.md are stored. Defaults to ./data
# GOPHER_DATA_DIR=/absolute/path/to/data

# Local Ollama endpoint used by the digest tools.
# GOPHER_OLLAMA_URL=http://localhost:11434/api/generate
# GOPHER_OLLAMA_MODEL=llama3.2
